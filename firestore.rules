rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Items collection rules: readable and writable through the application backend
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Rentals collection rules: readable and writable through the application backend
    match /rentals/{rentalId} {
      allow read, write: if true;
    }
  }
}
